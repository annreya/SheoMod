from .. import loader, utils
import asyncio
import time
import logging
from telethon.tl.types import (
    MessageEntityPre, MessageEntityCode, MessageEntityBold,
    MessageEntityItalic, MessageEntityUnderline, MessageEntityStrike,
    MessageEntitySpoiler,
)
from telethon.tl.functions.messages import EditMessageRequest

try:
    from telethon.tl.types import MessageEntityBlockquote
except ImportError:
    MessageEntityBlockquote = None

logger = logging.getLogger("sheopre")


# ==================== Конфиг ====================

SKIP_COMMANDS = True
EDIT_CAPTIONS = True
MAX_LEN = 4000
DEDUP_TTL = 10
DEDUP_MAX = 200
DEBUG = False
FIRE_AND_FORGET = True

# ==================== Данные ====================

MODES = {
    "pre":        ("pre",          "<pre>",         "</pre>"),
    "code":       ("code",         "<code>",        "</code>"),
    "precode":    ("pre + code",   "<pre><code>",   "</code></pre>"),
    "blockquote": ("цитата",       "<blockquote>",  "</blockquote>"),
    "bold":       ("жирный",       "<b>",           "</b>"),
    "italic":     ("курсив",       "<i>",           "</i>"),
    "underline":  ("подчёркнутый", "<u>",           "</u>"),
    "strike":     ("зачёркнутый",  "<s>",           "</s>"),
    "spoiler":    ("спойлер",      "<tg-spoiler>",  "</tg-spoiler>"),
}

DEFAULT_MODE = "pre"
DEFAULT_LANG = ""

COMMON_LANGS_HINT = (
    "python, javascript, typescript, java, kotlin, c, cpp, csharp, "
    "go, rust, php, ruby, swift, sql, json, yaml, xml, html, css, "
    "bash, shell, dockerfile, lua, r, dart, perl, scala, ..."
)

_COMMAND_CHARS = frozenset("./!")
_MODE_KEYS = frozenset(MODES.keys())

ENTITY_FACTORIES = {
    "pre":        lambda n, l: MessageEntityPre(offset=0, length=n, language=""),
    "precode":    lambda n, l: MessageEntityPre(offset=0, length=n, language=l or ""),
    "code":       lambda n, l: MessageEntityCode(offset=0, length=n),
    "bold":       lambda n, l: MessageEntityBold(offset=0, length=n),
    "italic":     lambda n, l: MessageEntityItalic(offset=0, length=n),
    "underline":  lambda n, l: MessageEntityUnderline(offset=0, length=n),
    "strike":     lambda n, l: MessageEntityStrike(offset=0, length=n),
    "spoiler":    lambda n, l: MessageEntitySpoiler(offset=0, length=n),
}
if MessageEntityBlockquote is not None:
    ENTITY_FACTORIES["blockquote"] = lambda n, l: MessageEntityBlockquote(offset=0, length=n)

# HTML-экранирование для формы
_ESC_TABLE = str.maketrans({"&": "&amp;", "<": "&lt;", ">": "&gt;"})


class SheoPreMod(loader.Module):
    """Оборачивает ваши сообщения в форматирование"""

    strings = {"name": "SheoPre"}

    __slots__ = (
        "database", "client", "enabled", "mode", "language",
        "_entity_factory", "_mode_label_cache",
        "_processed", "_shutdown", "_pending",
    )

    def __init__(self):
        self.database = None
        self.client = None
        self.enabled = True
        self.mode = DEFAULT_MODE
        self.language = DEFAULT_LANG
        self._entity_factory = ENTITY_FACTORIES[DEFAULT_MODE]
        self._mode_label_cache = MODES[DEFAULT_MODE][0]
        self._processed = {}
        self._shutdown = False
        self._pending = set()
        super().__init__()

    async def client_ready(self, client, database):
        self.client = client
        self.database = database
        self.enabled = self.database.get("SheoPre", "enabled", True)
        mode = self.database.get("SheoPre", "mode", DEFAULT_MODE)
        self.language = self.database.get("SheoPre", "language", DEFAULT_LANG) or ""
        self._apply_mode(mode if mode in _MODE_KEYS else DEFAULT_MODE)
        self._shutdown = False

    async def on_unload(self):
        self._shutdown = True
        for t in list(self._pending):
            t.cancel()

    # ==================== Внутренние ====================

    def _apply_mode(self, key):
        self.mode = key
        name, _o, _c = MODES[key]
        self._mode_label_cache = name
        self._entity_factory = ENTITY_FACTORIES.get(key)

    def _apply_language(self, code):
        self.language = (code or "").strip()

    def _is_recent(self, msg_id):
        d = self._processed
        if msg_id in d:
            return True
        d[msg_id] = time.time()
        if len(d) > DEDUP_MAX:
            cutoff = time.time() - DEDUP_TTL
            for k in [k for k, t in d.items() if t < cutoff]:
                d.pop(k, None)
        return False

    def _spawn(self, coro):
        task = asyncio.create_task(coro)
        self._pending.add(task)
        task.add_done_callback(self._pending.discard)

    async def _do_edit(self, peer, msg_id, text, entity):
        try:
            await self.client(EditMessageRequest(
                peer=peer,
                id=msg_id,
                message=text,
                entities=[entity],
            ))
        except Exception:
            if DEBUG:
                logger.info(f"SheoPre: edit fail {msg_id}")

    def _preview_wrap(self, plain_text):
        """Оборачивает plain-текст в HTML-теги согласно текущему режиму.
        Внутренние спецсимволы экранируются, чтобы не сломать разметку."""
        inner = plain_text.translate(_ESC_TABLE)
        key = self.mode
        if key == "pre":
            return f"<pre>{inner}</pre>"
        if key == "code":
            return f"<code>{inner}</code>"
        if key == "precode":
            lang = (self.language or "").strip()
            if lang:
                return f'<pre><code class="language-{lang}">{inner}</code></pre>'
            return f"<pre><code>{inner}</code></pre>"
        if key == "blockquote":
            return f"<blockquote>{inner}</blockquote>"
        if key == "bold":
            return f"<b>{inner}</b>"
        if key == "italic":
            return f"<i>{inner}</i>"
        if key == "underline":
            return f"<u>{inner}</u>"
        if key == "strike":
            return f"<s>{inner}</s>"
        if key == "spoiler":
            return f"<tg-spoiler>{inner}</tg-spoiler>"
        return inner

    # ==================== Watcher ====================

    async def watcher(self, message):
        if self._shutdown or not self.enabled or self._entity_factory is None:
            return
        if not message.out:
            return
        if message.edit_date is not None:
            return

        text = message.text
        if text is None:
            text = message.caption
            if text is None or not EDIT_CAPTIONS:
                return

        if SKIP_COMMANDS and text and text[0] in _COMMAND_CHARS:
            return

        if len(text) > MAX_LEN:
            return

        if self._is_recent(message.id):
            return

        length = len(text.encode("utf-16-le")) // 2
        entity = self._entity_factory(length, self.language)

        peer = getattr(message, "input_chat", None)
        if peer is None:
            peer = message.chat_id
        msg_id = message.id

        coro = self._do_edit(peer, msg_id, text, entity)
        if FIRE_AND_FORGET:
            self._spawn(coro)
        else:
            await coro

    # ==================== Инлайн-форма ====================

    async def _build_modes_page(self):
        # Plain-текст, который будет обёрнут в текущий режим
        plain = (
            f"Включено: {'да' if self.enabled else 'нет'}\n"
            f"Режим: {self._mode_label_cache}\n\n"
        )

        # Оборачиваем всё полотно в текущий режим
        text = self._preview_wrap(plain)

        buttons = [[{
            "text": "Выключить" if self.enabled else "Включить",
            "callback": self._toggle_callback,
            "args": (),
        }]]

        row = []
        for key, (name, _o, _c) in MODES.items():
            label = f"[{name}]" if key == self.mode else name
            row.append({
                "text": label,
                "callback": self._mode_callback,
                "args": (key,),
            })
            if len(row) == 2:
                buttons.append(row)
                row = []
        if row:
            buttons.append(row)

        buttons.append([{"text": "Закрыть", "action": "close"}])
        return text, buttons

    async def _toggle_callback(self, call):
        self.enabled = not self.enabled
        self.database.set("SheoPre", "enabled", self.enabled)
        try:
            await call.answer(
                f"Обёртка {'включена' if self.enabled else 'выключена'}",
                show_alert=False,
            )
        except Exception:
            pass
        text, buttons = await self._build_modes_page()
        try:
            await call.edit(text=text, reply_markup=buttons)
        except Exception:
            pass

    async def _mode_callback(self, call, key):
        if key not in _MODE_KEYS:
            try:
                await call.answer("Неизвестный режим", show_alert=True)
            except Exception:
                pass
            return

        self._apply_mode(key)
        self.database.set("SheoPre", "mode", key)

        try:
            await call.answer(f"Режим: {self._mode_label_cache}", show_alert=False)
        except Exception:
            pass

        text, buttons = await self._build_modes_page()
        try:
            await call.edit(text=text, reply_markup=buttons)
        except Exception:
            pass

    # ==================== Команды ====================

    @loader.command(
        ru_doc="Форма выбора режима",
        en_doc="Mode selection form",
    )
    async def преcmd(self, message):
        """Форма выбора режима"""
        args = utils.get_args_raw(message)
        if args:
            key = args.strip().lower()

            if key in _MODE_KEYS:
                self._apply_mode(key)
                self.database.set("SheoPre", "mode", key)
                try:
                    await message.edit(
                        self._preview_wrap(f"Режим: {self._mode_label_cache}")
                    )
                except Exception:
                    pass
                return

            if key in ("on", "вкл", "enable"):
                self.enabled = True
                self.database.set("SheoPre", "enabled", True)
                try:
                    await message.edit(self._preview_wrap("Обёртка включена"))
                except Exception:
                    pass
                return

            if key in ("off", "выкл", "disable"):
                self.enabled = False
                self.database.set("SheoPre", "enabled", False)
                try:
                    await message.edit(self._preview_wrap("Обёртка выключена"))
                except Exception:
                    pass
                return

            modes_list = ", ".join(f"<code>{k}</code>" for k in MODES.keys())
            try:
                await message.edit(
                    f"Неизвестная команда: <code>{key}</code>\n\n"
                    f"<b>Режимы:</b> {modes_list}\n"
                    f"<b>Вкл/выкл:</b> <code>.пре on</code> / <code>.пре off</code>"
                )
            except Exception:
                pass
            return

        try:
            text, buttons = await self._build_modes_page()
            await self.inline.form(
                text=text,
                message=message,
                reply_markup=buttons,
                silent=True,
            )
        except Exception as e:
            logger.error(f"преcmd form: {e}")

    @loader.command(
        ru_doc="<код> — указать язык подсветки для pre + code",
        en_doc="<code> — set syntax highlighting language for pre + code",
    )
    async def язcmd(self, message):
        """Указать язык подсветки"""
        args = utils.get_args_raw(message)
        code = (args or "").strip()

        if not code:
            current = self.language if self.language else "(не задан)"
            try:
                await message.edit(
                    self._preview_wrap(
                        f"Язык подсветки: {current}\n\n"
                        f"Установить: .яз python\n"
                        f"Очистить: .яз clear\n\n"
                        f"{COMMON_LANGS_HINT}"
                    )
                )
            except Exception:
                pass
            return

        if code.lower() in ("clear", "none", "off", "-"):
            self._apply_language("")
            self.database.set("SheoPre", "language", "")
            try:
                await message.edit(self._preview_wrap("Язык очищен"))
            except Exception:
                pass
            return

        self._apply_language(code)
        self.database.set("SheoPre", "language", self.language)
        try:
            await message.edit(self._preview_wrap(f"Язык: {self.language}"))
        except Exception:
            pass
