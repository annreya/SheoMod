    # ==================== Caches ====================

    def _cache_document(self, document, meta=None):
        raw = f"{getattr(document, 'id', 0)}-{time.time()}-{id(document)}"
        uid = hashlib.md5(raw.encode()).hexdigest()[:16]
        self.doc_cache[uid] = (document, time.time() + DOC_TTL, meta or {})
        return uid

    def _get_cached_document(self, uid):
        entry = self.doc_cache.get(uid)
        if not entry:
            return None, None
        document, exp, meta = entry
        if time.time() > exp:
            self.doc_cache.pop(uid, None)
            return None, None
        return document, meta

    # ==================== Spam & bot health ====================

    def check_spam(self, user_id):
        if not user_id:
            return True
        now = time.time()
        last = self.spam_protection.get(user_id, 0)
        if now - last < SPAM_WINDOW:
            return False
        self.spam_protection[user_id] = now
        return True

    def is_bot_failed(self, bot_username):
        entry = self.failed_bots.get(bot_username)
        if entry is None:
            return False
        ts, cnt = entry
        ttl = min(BOT_FAIL_TTL * (2 ** (cnt - 1)), BOT_FAIL_MAX)
        if time.time() - ts < ttl:
            return True
        self.failed_bots.pop(bot_username, None)
        return False

    def mark_bot_failed(self, bot_username):
        entry = self.failed_bots.get(bot_username)
        if entry is None:
            self.failed_bots[bot_username] = (time.time(), 1)
        else:
            _, cnt = entry
            self.failed_bots[bot_username] = (time.time(), min(cnt + 1, 8))

    def mark_bot_ok(self, bot_username):
        self.failed_bots.pop(bot_username, None)

    # ==================== Search primitives ====================

    def _is_audio_document(self, doc):
        try:
            for a in (getattr(doc, "attributes", []) or []):
                if isinstance(a, DocumentAttributeAudio):
                    return True
            mime = (getattr(doc, "mime_type", "") or "").lower()
            return mime.startswith("audio/")
        except Exception:
            return False

    def _doc_duration(self, doc):
        try:
            for a in (getattr(doc, "attributes", []) or []):
                if isinstance(a, DocumentAttributeAudio):
                    return int(getattr(a, "duration", 0) or 0)
        except Exception:
            pass
        return 0

    def _doc_bitrate(self, doc):
        try:
            for a in (getattr(doc, "attributes", []) or []):
                if isinstance(a, DocumentAttributeAudio):
                    br = getattr(a, "bitrate", None)
                    return int(br) if br else 0
        except Exception:
            pass
        return 0

    def _parse_inline_results(self, bot_username, results):
        if not results:
            return []

        music_results = []
        scan_limit = min(len(results), RAW_SCAN_LIMIT)

        for pos in range(scan_limit):
            if len(music_results) >= RESULTS_PER_BOT:
                break
            try:
                result = results[pos]
                inner = getattr(result, "result", None)
                if not inner:
                    continue
                doc = getattr(inner, "document", None)
                if not doc:
                    continue
                if not self._is_audio_document(doc):
                    continue

                raw_title = getattr(inner, "title", "") or ""
                info = self.extract_track_info_from_document(doc, raw_title)
                info["bot"] = bot_username
                info["document"] = doc
                info["position"] = pos
                info["duration"] = self._doc_duration(doc)
                info["bitrate"] = self._doc_bitrate(doc)
                info["size"] = getattr(doc, "size", 0) or 0
                info["mime"] = getattr(doc, "mime_type", "") or ""
                music_results.append(info)
            except Exception as e:
                logger.error(f"Обработка результата от @{bot_username}: {e}")
                continue

        return music_results

    async def _raw_inline_query(self, bot_username, query, timeout):
        async with self._inline_sem:
            try:
                results = await asyncio.wait_for(
                    self.client.inline_query(bot_username, query),
                    timeout=timeout,
                )
                return results, None
            except asyncio.TimeoutError:
                return None, "timeout"
            except Exception as e:
                return None, str(e)

    async def search_in_bot(self, bot_username, query):
        if self.is_bot_failed(bot_username):
            return []

        results, err = await self._raw_inline_query(bot_username, query, SEARCH_TIMEOUT)

        if err is not None:
            low = err.lower()
            if "can't be used in inline mode" in low or "bot can't be used" in low:
                logger.warning(f"@{bot_username} не поддерживает инлайн — отключён")
                self.mark_bot_failed(bot_username)
                return []
            if "wait" in low and "second" in low:
                logger.debug(f"@{bot_username} на кулдауне, повтор через {COOLDOWN_RETRY_DELAY}с")
                await asyncio.sleep(COOLDOWN_RETRY_DELAY)
                results, err2 = await self._raw_inline_query(bot_username, query, SEARCH_TIMEOUT)
                if err2 is not None:
                    logger.debug(f"@{bot_username} повтор не удался: {err2}")
                    return []
            else:
                logger.error(f"Поиск в @{bot_username}: {err}")
                return []

        parsed = self._parse_inline_results(bot_username, results)
        if parsed:
            self.mark_bot_ok(bot_username)
        return parsed

    # ==================== Scoring ====================

    def _normalize(self, text):
        if not text:
            return ""
        text = text.lower()
        text = re.sub(r"[^\w\s]", " ", text, flags=re.UNICODE)
        text = re.sub(r"\s+", " ", text).strip()
        return text

    def calculate_relevance_score(self, track_info, query):
        if not query or not track_info:
            return 0

        q_norm = self._normalize(query)
        title = self._normalize(track_info.get("title", ""))
        performer = self._normalize(track_info.get("performer", ""))
        raw = self._normalize(track_info.get("raw_title", ""))
        combined = f"{performer} {title}".strip()

        if not q_norm:
            return 0

        q_words = [w for w in q_norm.split() if len(w) >= 2 and w not in NOISE_WORDS]
        if not q_words:
            q_words = [w for w in q_norm.split() if len(w) >= 2]
        if not q_words:
            return 0

        score = 0

        if q_norm == combined:
            score += 300
        if q_norm == title:
            score += 250
        if q_norm == performer:
            score += 180

        if title and q_norm in title:
            score += 100
        if performer and q_norm in performer:
            score += 70
        if combined and q_norm in combined:
            score += 60
        if raw and q_norm in raw:
            score += 50

        if " - " in query:
            parts = [self._normalize(p) for p in query.split(" - ", 1)]
            if len(parts) == 2 and all(parts):
                a, b = parts
                if (a in performer and b in title) or (b in performer and a in title):
                    score += 120

        title_words = set(title.split())
        perf_words = set(performer.split())
        raw_words = set(raw.split())

        matched = 0.0
        for w in q_words:
            if w in title_words:
                matched += 1
                score += 18 if len(w) > 4 else 12
            elif w in perf_words:
                matched += 1
                score += 15
            elif w in raw_words:
                matched += 1
                score += 8
            elif w in combined:
                matched += 0.4
                score += 4

        total = len(q_words)
        ratio = matched / total if total else 0

        if ratio >= 1.0:
            score += 60
        elif ratio >= 0.75:
            score += 25
        elif ratio >= 0.5:
            score += 8
        elif ratio < 0.4:
            score -= 30

        if title and len(title_words) > len(q_words) * 3:
            score -= 10

        if title and performer:
            score += 8

        dur = track_info.get("duration", 0) or 0
        if dur:
            if 90 <= dur <= 480:
                score += 10
            elif dur > 1200:
                score -= 25
            elif dur < 45:
                score -= 15

        br = track_info.get("bitrate", 0) or 0
        if br:
            if br >= 320:
                score += 12
            elif br >= 192:
                score += 6
            elif br and br < 128:
                score -= 8

        return score

    def extract_track_info_from_document(self, document, raw_title=""):
        if not document:
            return {"title": "", "performer": "", "raw_title": raw_title}

        title = ""
        performer = ""
        filename = ""

        for attr in getattr(document, "attributes", []) or []:
            if isinstance(attr, DocumentAttributeAudio):
                if getattr(attr, "title", None):
                    title = attr.title
                if getattr(attr, "performer", None):
                    performer = attr.performer
            elif isinstance(attr, DocumentAttributeFilename):
                filename = attr.file_name or ""

        if not title and filename:
            name = re.sub(
                r"\.(mp3|m4a|ogg|flac|wav|opus|aac)$",
                "", filename, flags=re.IGNORECASE,
            )
            if " - " in name:
                parts = name.split(" - ", 1)
                performer = parts[0].strip()
                title = parts[1].strip()
            else:
                title = name

        title = self._strip_ads(title)
        performer = self._strip_ads(performer)
        return {"title": title, "performer": performer, "raw_title": raw_title}

    def _filter_duplicate_tracks(self, tracks, limit=MAX_RESULTS, per_title_limit=PER_TITLE_LIMIT):
        if not tracks:
            return []

        unique = []
        seen_doc_ids = set()
        title_counts = {}

        for track in tracks:
            doc = track.get("document")
            doc_id = getattr(doc, "id", None)

            if doc_id and doc_id in seen_doc_ids:
                continue

            title = self._normalize(track.get("title", ""))

            if title:
                cnt = title_counts.get(title, 0)
                if cnt >= per_title_limit:
                    continue
                title_counts[title] = cnt + 1

            if doc_id:
                seen_doc_ids.add(doc_id)

            unique.append(track)
            if len(unique) >= limit:
                break

        return unique

    # ==================== Search flows ====================

    async def _gather_search(self, query):
        bots = [b for b in self.music_bots if not self.is_bot_failed(b)]
        if not bots:
            return []

        tasks = {asyncio.create_task(self.search_in_bot(b, query)): b for b in bots}

        done, pending = await asyncio.wait(
            tasks.keys(),
            timeout=SEARCH_TOTAL_TIMEOUT,
            return_when=asyncio.ALL_COMPLETED,
        )

        results = []
        for t in done:
            bot = tasks[t]
            try:
                r = t.result()
                if r:
                    results.append(r)
            except Exception as e:
                logger.debug(f"@{bot} ошибка при сборе: {e}")

        for t in pending:
            bot = tasks[t]
            logger.warning(f"@{bot} не ответил за {SEARCH_TOTAL_TIMEOUT}с — пропущен")
            t.cancel()
            try:
                await t
            except Exception:
                pass

        return results

    def _boost_for_query(self, bot_name, query):
        bonus = 0
        lang = self._detect_lang(query)
        b = bot_name.lower()
        if lang == "ru" and b in RU_BOTS:
            bonus += 6
        elif lang == "en" and b in EN_BOTS:
            bonus += 6
        return bonus

    def _personal_bonus(self, user_id, bot_name):
        if not user_id:
            return 0
        prefs = self.database.get("SheoMus", f"prefs_{user_id}", {})
        if not isinstance(prefs, dict):
            return 0
        return prefs.get(bot_name.lower(), 0)

    def _bump_preference(self, user_id, bot_name):
        if not user_id:
            return
        key = f"prefs_{user_id}"
        prefs = self.database.get("SheoMus", key, {}) or {}
        if not isinstance(prefs, dict):
            prefs = {}
        b = bot_name.lower()
        prefs[b] = min(prefs.get(b, 0) + 1, 50)
        if len(prefs) > 30:
            items = sorted(prefs.items(), key=lambda x: x[1], reverse=True)[:30]
            prefs = dict(items)
        self.database.set("SheoMus", key, prefs)

    async def search_music(self, query):
        if not query:
            return None
        query = query.strip()
        if not query:
            return None

        results_lists = await self._gather_search(query)
        if not results_lists:
            return None

        best_score = -1
        best_doc = None

        for rlist in results_lists:
            if not rlist:
                continue
            for r in rlist:
                doc = r.get("document")
                if not doc:
                    continue
                score = self.calculate_relevance_score(r, query)
                pos = r.get("position", 0)
                score += max(0, 12 - pos)
                bot_name = (r.get("bot") or "").lower()
                score += BOT_WEIGHTS.get(bot_name, 0)
                score += self._boost_for_query(bot_name, query)
                if bot_name in PREFERRED_BOTS:
                    score += 5
                if score > best_score:
                    best_score = score
                    best_doc = doc

        if best_score < 15:
            return None
        return best_doc

    async def search_music_inline(self, query, user_id=None, sort="relevance", bot_filter=None):
        if not query:
            return []
        query = query.strip()
        if not query:
            return []

        cache_key = f"{query.lower()}|{sort}|{bot_filter or ''}"
        cached = self.search_cache.get(cache_key)
        if cached and time.time() - cached[1] < SEARCH_CACHE_TTL:
            return cached[0]

        results_lists = await self._gather_search(query)
        if not results_lists:
            return []

        all_scored = []
        for rlist in results_lists:
            if not rlist:
                continue
            for r in rlist:
                doc = r.get("document")
                if not doc:
                    continue
                bot_name = (r.get("bot") or "").lower()
                if bot_filter and bot_name != bot_filter.lower():
                    continue

                score = self.calculate_relevance_score(r, query)
                pos = r.get("position", 0)
                score += max(0, 12 - pos)
                score += BOT_WEIGHTS.get(bot_name, 0)
                score += self._boost_for_query(bot_name, query)
                score += self._personal_bonus(user_id, bot_name)
                all_scored.append((score, r))

        if not all_scored:
            return []

        if sort == "duration":
            all_scored.sort(key=lambda x: (x[1].get("duration") or 0))
        elif sort == "bitrate":
            all_scored.sort(key=lambda x: (-(x[1].get("bitrate") or 0), -x[0]))
        else:
            all_scored.sort(key=lambda x: x[0], reverse=True)

        tracks = [t for _, t in all_scored]
        unique = self._filter_duplicate_tracks(
            tracks, limit=MAX_RESULTS, per_title_limit=PER_TITLE_LIMIT
        )

        self.search_cache[cache_key] = (unique, time.time())
        return unique

    # ==================== History ====================

    def _history_key(self, user_id):
        return f"history_{user_id}"

    def _add_history(self, user_id, query):
        if not user_id:
            return
        key = self._history_key(user_id)
        hist = self.database.get("SheoMus", key, []) or []
        if not isinstance(hist, list):
            hist = []
        hist = [h for h in hist if h.lower() != query.lower()]
        hist.insert(0, query)
        hist = hist[:HISTORY_LIMIT]
        self.database.set("SheoMus", key, hist)

    def _get_history(self, user_id):
        return self.database.get("SheoMus", self._history_key(user_id), []) or []

    # ==================== Inline page building ====================

    async def _build_music_page(
        self, query, page, chat_id, user_id=None,
        sort="relevance", bot_filter=None,
    ):
        results = await self.search_music_inline(
            query, user_id=user_id, sort=sort, bot_filter=bot_filter
        )
        total = len(results)
        total_pages = max(1, (total + PAGE_SIZE - 1) // PAGE_SIZE)
        page = max(0, min(page, total_pages - 1))

        if total == 0:
            return "Ничего не найдено", [[{"text": "Закрыть", "action": "close"}]]

        start = page * PAGE_SIZE
        page_results = results[start : start + PAGE_SIZE]

        buttons = []
        for i, track in enumerate(page_results, start=start + 1):
            title = track.get("title", "") or "Неизвестный трек"
            performer = track.get("performer", "")
            bot = track.get("bot", "")
            bot_tag = ""
            if bot:
                short = re.sub(r"[_\s]?bot$", "", bot, flags=re.IGNORECASE)
                if short and short.lower() != bot.lower():
                    bot_tag = f" [{short}]"

            if performer:
                name = f"{i}. {performer} - {title}{bot_tag}"
            else:
                name = f"{i}. {title}{bot_tag}"

            if len(name) > 45:
                name = name[:42] + "..."

            uid = self._cache_document(track["document"], {
                "query": query,
                "bot": bot,
                "title": title,
                "performer": performer,
            })
            buttons.append([
                {
                    "text": name,
                    "callback": self._send_music_callback,
                    "args": (uid, chat_id, user_id),
                },
                {
                    "text": "Инфо",
                    "callback": self._info_callback,
                    "args": (uid,),
                },
            ])

        nav = []
        if page > 0:
            nav.append({
                "text": "Назад",
                "callback": self._page_callback,
                "args": (query, page - 1, chat_id, user_id, sort, bot_filter),
            })
        if page < total_pages - 1:
            nav.append({
                "text": "Вперед",
                "callback": self._page_callback,
                "args": (query, page + 1, chat_id, user_id, sort, bot_filter),
            })
        if nav:
            buttons.append(nav)

        buttons.append([
            {
                "text": "Все альбомом",
                "callback": self._album_page_callback,
                "args": (query, page, chat_id, user_id, sort, bot_filter),
            },
        ])

        sort_row = []
        for label, key in (("По релевантности", "relevance"),
                           ("По длительности", "duration"),
                           ("По битрейту", "bitrate")):
            mark = "• " if key == sort else ""
            sort_row.append({
                "text": f"{mark}{label}",
                "callback": self._page_callback,
                "args": (query, 0, chat_id, user_id, key, bot_filter),
            })
        buttons.append(sort_row)

        buttons.append([{"text": "Закрыть", "action": "close"}])

        text = (
            f"Страница {page + 1}/{total_pages} | Найдено: {total}\n"
            f"Сортировка: {sort}"
            + (f" | Фильтр: @{bot_filter}" if bot_filter else "")
        )
        return text, buttons

    async def _send_music_callback(self, call, uid, chat_id, user_id=None):
        document, meta = self._get_cached_document(uid)
        if not document:
            await call.answer("Трек недоступен, попробуйте заново", show_alert=True)
            return

        target = chat_id or getattr(call, "chat_id", None)

        try:
            await call.answer()
        except Exception:
            pass
        try:
            await call.delete()
        except Exception:
            pass

        if target is None:
            return

        await self._send_track(target, document)
        if meta and meta.get("bot") and user_id:
            self._bump_preference(user_id, meta["bot"])

    async def _info_callback(self, call, uid):
        document, meta = self._get_cached_document(uid)
        if not document:
            await call.answer("Информация недоступна", show_alert=True)
            return

        dur = self._doc_duration(document)
        br = self._doc_bitrate(document)
        size = (getattr(document, "size", 0) or 0) / 1024 / 1024
        mime = getattr(document, "mime_type", "") or "?"

        minutes = dur // 60
        seconds = dur % 60
        dur_str = f"{minutes}:{seconds:02d}" if dur else "?"

        text = (
            f"{meta.get('performer', '')} - {meta.get('title', '')}\n"
            f"@{meta.get('bot', '?')}\n"
            f"Длительность: {dur_str}\n"
            f"Битрейт: {br or '?'} kbps\n"
            f"Размер: {size:.2f} MB\n"
            f"MIME: {mime}"
        )
        try:
            await call.answer(text, show_alert=True)
        except Exception:
            pass

