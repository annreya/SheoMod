    @loader.command(
        ru_doc="<юзернейм> - Добавляет бота в список",
        en_doc="<username> - Adds bot to search list",
    )
    async def addbotmcmd(self, message):
        """Добавить бота для поиска"""

        args = utils.get_args_raw(message)
        if not args:
            await self._safe_edit(message, "Укажите username бота")
            return

        bot = args.replace("@", "").strip().lower()
        if not bot:
            await self._safe_edit(message, "Некорректный username")
            return

        existing = [b.lower() for b in self.music_bots]
        if bot in existing:
            await self._safe_edit(message, "Этот бот уже в списке")
            return

        current = self.music_bots
        current.append(bot)
        self.music_bots = current
        await self._safe_edit(message, f"Бот @{bot} добавлен в список")

    @loader.command(
        ru_doc="<юзернейм> - Удаляет бота из списка",
        en_doc="<username> - Removes bot from list",
    )
    async def delbotmcmd(self, message):
        """Удалить бота из поиска"""

        args = utils.get_args_raw(message)
        if not args:
            await self._safe_edit(message, "Укажите username бота")
            return

        bot = args.replace("@", "").strip().lower()
        current = self.music_bots
        new_list = [b for b in current if b.lower() != bot]

        if len(new_list) == len(current):
            await self._safe_edit(message, "Этот бот не найден в списке")
            return

        self.music_bots = new_list
        self.failed_bots.pop(bot, None)
        await self._safe_edit(message, f"Бот @{bot} удален из списка")

    @loader.command(
        ru_doc="Сбрасывает список ботов к исходному",
        en_doc="Resets bot list to default",
    )
    async def resetbotsmcmd(self, message):
        """Сброс списка ботов к дефолтному"""

        current = [b.lower() for b in self.music_bots]
        default = [b.lower() for b in DEFAULT_BOTS]

        if current == default:
            await self._safe_edit(message, "Список ботов уже соответствует исходному")
            return

        self.music_bots = DEFAULT_BOTS.copy()
        self.failed_bots.clear()

        lines = ["Список ботов сброшен:", ""]
        for i, b in enumerate(DEFAULT_BOTS, 1):
            lines.append(f"{i}. @{b}")
        lines.append("")
        lines.append("Все боты разблокированы")
        await self._safe_edit(message, "\n".join(lines))

