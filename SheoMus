    @loader.command(
        ru_doc="[id] - Удаляет чат из списка разрешенных",
        en_doc="[id] - Removes chat from allowed list",
    )
    async def delmcmd(self, message):
        """Удалить чат из разрешенных"""

        args = utils.get_args_raw(message)
        chat_id = args.strip() if args else self._get_chat_id(message)

        if chat_id == "0":
            await self._safe_edit(message, "Не удалось определить ID чата")
            return

        current = self.allowed_chats
        if chat_id not in current:
            await self._safe_edit(message, "Этот чат не найден в списке")
            return

        current.remove(chat_id)
        self.allowed_chats = current
        await self._safe_edit(message, f"Чат удален. ID: {chat_id}")

    @loader.command(
        ru_doc="Показывает список разрешенных чатов",
        en_doc="Shows allowed chats list",
    )
    async def listmcmd(self, message):
        """Список разрешенных чатов"""

        chats = self.allowed_chats
        if not chats:
            await self._safe_edit(message, "Список разрешенных чатов пуст")
            return

        lines = ["Разрешенные чаты:", ""]
        for cid in chats:
            try:
                entity = await self.client.get_entity(int(cid))
                title = (
                    getattr(entity, "title", None)
                    or getattr(entity, "first_name", None)
                    or "Личные сообщения"
                )
                lines.append(f"- {title} ({cid})")
            except Exception:
                lines.append(f"- Неизвестный чат ({cid})")

        await self._safe_edit(message, "\n".join(lines))

