    "spotifydownloader_bot",
    "losslessrobot",
    "loaditbot",
]

PREFERRED_BOTS = {"vkmusic_bot", "tgmusicbot", "spotifydownloader_bot"}

BOT_WEIGHTS = {
    "vkmusic_bot": 4,
    "tgmusicbot": 3,
    "spotifydownloader_bot": 3,
    "losslessrobot": 3,
    "loaditbot": 2,
    "lybot": 1,
}

RU_BOTS = {"vkmusic_bot", "lybot"}
EN_BOTS = {"spotifydownloader_bot", "loaditbot"}

NOISE_WORDS = {
    "скачать", "download", "минус", "минусовка", "minus",
    "official", "lyrics", "текст", "клип", "clip",
    "hd", "hq", "mp3", "flac", "audio", "video",
    "песня", "song", "трек", "track", "music", "музыка",
}

AD_PATTERNS = [
    re.compile(r"@[\w_]{3,}", re.IGNORECASE),
    re.compile(r"t\.me/\S+", re.IGNORECASE),
    re.compile(r"https?://\S+", re.IGNORECASE),
    re.compile(r"\bsubscribe\b", re.IGNORECASE),
    re.compile(r"\bподпишись\b", re.IGNORECASE),
    re.compile(r"\bподписывайся\b", re.IGNORECASE),
    re.compile(r"\bреклама\b", re.IGNORECASE),
    re.compile(r"\bпромокод\b", re.IGNORECASE),
    re.compile(r"\[[^\]]{0,20}promo[^\]]{0,20}\]", re.IGNORECASE),
]

PAGE_SIZE = 10
DOC_TTL = 1800
BOT_FAIL_TTL = 3600
BOT_FAIL_MAX = 43200
SPAM_WINDOW = 5
CLEANUP_INTERVAL = 60
HEALTHCHECK_INTERVAL = 1800

SEARCH_TIMEOUT = 6.0
SEARCH_TOTAL_TIMEOUT = 7.5
COOLDOWN_RETRY_DELAY = 1.2

RESULTS_PER_BOT = 15
RAW_SCAN_LIMIT = 40
