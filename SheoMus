                err = await self._safe_respond(message, f"Бот @{bot} добавлен")
                await self.delete_after(err, 3)
                return

            # .бот - username
            if args.startswith("-"):
                bot = args[1:].strip().replace("@", "").lower()
                if not bot:
                    err = await self._safe_respond(message, "Укажите username бота")
                    await self.delete_after(err, 3)
                    return
                current = self.music_bots
                new_list = [b for b in current if b.lower() != bot]
                if len(new_list) == len(current):
                    err = await self._safe_respond(message, "Этот бот не найден в списке")
                    await self.delete_after(err, 3)
                    return
                self.music_bots = new_list
                self.failed_bots.pop(bot, None)
                err = await self._safe_respond(message, f"Бот @{bot} удален")
                await self.delete_after(err, 3)
                return

