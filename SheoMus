class SheoMusMod(loader.Module):
    """Мультипоиск музыки"""

    strings = {"name": "SheoMus"}

    def __init__(self):
        self.database = None
        self.client = None
        self.spam_protection = {}
        self.failed_bots = {}
        self.doc_cache = {}
        self.search_cache = {}
        self.emojis_enabled = True
        self._last_cleanup = time.time()
        self._cleanup_task = None
        self._health_task = None
        self._inline_sem = asyncio.Semaphore(MAX_CONCURRENT_INLINE)
        self._shutdown = False
        super().__init__()

    async def client_ready(self, client, database):
        self.client = client
        self.database = database
        if not self.database.get("SheoMus", "allowed_chats"):
            self.database.set("SheoMus", "allowed_chats", [])
        if not self.database.get("SheoMus", "music_bots"):
            self.database.set("SheoMus", "music_bots", DEFAULT_BOTS.copy())
        self.emojis_enabled = self.database.get("SheoMus", "emojis_enabled", True)

        self._shutdown = False
        self._cleanup_task = asyncio.create_task(self._background_cleanup())
        self._health_task = asyncio.create_task(self._background_healthcheck())
        logger.info("SheoMus: background tasks started")

    async def on_unload(self):
        self._shutdown = True
        for t in (self._cleanup_task, self._health_task):
            if t and not t.done():
                t.cancel()
                try:
                    await t
                except Exception:
                    pass

