                ".бот - username — удалить\n"
                ".бот reset — сброс",
            )
            await self.delete_after(err, 5)
            return

        # .бот без аргументов — открываем форму
        await self._safe_delete(message)

        try:
            loading = await self.client.send_message(message.chat_id, "...")
        except Exception as e:
