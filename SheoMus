    # ---------- Watcher ----------

    async def watcher(self, message):
        if not message or not message.text:
            return
        text = message.text
        if len(text) < 7:
            return

        chat_id = self._get_chat_id(message)
        if chat_id == "0" or chat_id not in self.allowed_chats:
            return

        lower = text.lower()

        if lower.startswith("найти "):
            if not self.check_spam(message.sender_id):
                await self._safe_delete(message)
                return
            query = text[6:].strip()
            if query:
                await self._execute_search_and_send(message, query)

        elif lower.startswith("найтими "):
            if not self.check_spam(message.sender_id):
                await self._safe_delete(message)
                return
            query = text[8:].strip()
            if query:
                await self._inline_search(message, query)

