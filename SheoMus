    # ==================== Search & send (no inline) ====================

    async def _execute_search_and_send(self, message, query):
        if not query:
            return

        chat_id = message.chat_id
        topic_id = self._get_topic_id(message)
        user_id = message.sender_id

        try:
            await self._safe_delete(message)
            status = await self._safe_respond(message, self.clock_emoji())

            self._add_history(user_id, query)

            doc = await self.search_music(query)

            if status:
                await self._safe_delete(status)

            if not doc:
                err = await self._safe_respond(message, "Музыка не найдена")
                await self.delete_after(err, 3)
                return

            doc_id = getattr(doc, "id", None)
            if doc_id and self._sent_recently(chat_id, doc_id):
                err = await self._safe_respond(message, "Этот трек уже недавно отправлялся")
                await self.delete_after(err, 3)
                return

            msg = await self._send_track(chat_id, doc, topic_id)
            if msg and doc_id:
                self._mark_sent(chat_id, doc_id)
        except Exception as e:
            logger.error(f"_execute_search_and_send: {e}")

    async def _inline_search(self, message, query):
        chat_id = message.chat_id
        user_id = message.sender_id
        await self._safe_delete(message)

        self._add_history(user_id, query)

        prefix = self.clock_emoji()
        loading_text = prefix if prefix else "..."

        try:
            loading = await self.client.send_message(chat_id, loading_text)
        except Exception as e:
            logger.error(f"_inline_search send loading: {e}")
            return

        try:
            text, buttons = await self._build_music_page(query, 0, chat_id, user_id)
            await self.inline.form(
                text=text,
                message=loading,
                reply_markup=buttons,
                silent=True,
            )
        except Exception as e:
            logger.error(f"_inline_search form: {e}")
            await self._safe_edit(loading, f"Ошибка: {e}")

    # ==================== Background tasks ====================

    async def _background_cleanup(self):
        while not self._shutdown:
            try:
                await asyncio.sleep(CLEANUP_INTERVAL)
                self._cleanup()
            except asyncio.CancelledError:
                return
            except Exception as e:
                logger.error(f"cleanup task: {e}")

    def _cleanup(self):
        now = time.time()

        for k in [k for k, (_, exp, _m) in self.doc_cache.items() if now > exp]:
            self.doc_cache.pop(k, None)

        cutoff = now - SPAM_WINDOW * 2
        self.spam_protection = {
            k: v for k, v in self.spam_protection.items() if v > cutoff
        }

        self.search_cache = {
            k: v for k, v in self.search_cache.items()
            if now - v[1] < SEARCH_CACHE_TTL * 2
        }

        for bot in list(self.failed_bots.keys()):
            if not self.is_bot_failed(bot):
                pass

        for cid in list(self.sent_cache.keys()):
            bucket = self.sent_cache[cid]
            self.sent_cache[cid] = {
                k: v for k, v in bucket.items() if now - v <= SENT_CACHE_TTL
            }
            if not self.sent_cache[cid]:
                self.sent_cache.pop(cid, None)

    async def _background_healthcheck(self):
        await asyncio.sleep(30)
        while not self._shutdown:
            try:
                bots = self.music_bots
                for bot in bots:
                    if self._shutdown:
                        return
                    if self.is_bot_failed(bot):
                        continue
                    try:
                        async with self._inline_sem:
                            await asyncio.wait_for(
                                self.client.inline_query(bot, "test"),
                                timeout=5.0,
                            )
                        self.mark_bot_ok(bot)
                    except Exception as e:
                        err = str(e).lower()
                        if "can't be used in inline mode" in err:
                            self.mark_bot_failed(bot)
                await asyncio.sleep(HEALTHCHECK_INTERVAL)
            except asyncio.CancelledError:
                return
            except Exception as e:
                logger.error(f"healthcheck task: {e}")
                await asyncio.sleep(300)

