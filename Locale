class _ONNXEngine:
    """ONNX Runtime GenAI: ленивая загрузка и потокобезопасная генерация."""

    def __init__(self, model_dir: str, chat_template: str, max_length: int = 4096):
        self.model_dir = Path(model_dir)
        self.chat_template = chat_template
        self.max_length = max_length
        self.model = None
        self.tokenizer = None
        self._lock = threading.Lock()

    def load(self) -> bool:
        if self.model is not None:
            return True
        try:
            import onnxruntime_genai as og
        except ImportError:
            logger.error(
                "onnxruntime-genai не установлен. Добавь в зависимости: onnxruntime-genai"
            )
            return False

        if not self.model_dir.exists():
            logger.error("Папка с моделью не найдена: %s", self.model_dir)
            return False

        cfg = self.model_dir / "genai_config.json"
        if not cfg.exists():
            logger.error(
                "genai_config.json не найден в %s. "
                "Проверь, что LOCAL_MODEL_PATH указывает на папку с конфигом GenAI.",
                self.model_dir,
            )
            return False

        try:
            t0 = time.time()
            self.model = og.Model(str(self.model_dir))
            self.tokenizer = og.Tokenizer(self.model)
            logger.info(
                "ONNX-модель загружена за %.1f сек (%s)",
                time.time() - t0, self.model_dir,
            )
            return True
        except Exception as e:
            logger.error("Ошибка загрузки ONNX-модели: %s", e)
            self.model = None
            self.tokenizer = None
            return False

    def generate(self, system_prompt: str, user_prompt: str,
                 max_tokens: int = 250, temperature: float = 0.7):
        if self.model is None or self.tokenizer is None:
            return None

        import onnxruntime_genai as og

        chat = self.chat_template.format(
            system=system_prompt, user=user_prompt
        )

        with self._lock:
            try:
                input_tokens = self.tokenizer.encode(chat)
                params = og.GeneratorParams(self.model)
                params.set_search_options(
                    max_length=min(self.max_length, max_tokens + len(input_tokens)),
                    temperature=temperature,
                    top_p=0.9,
                    do_sample=True,
                )
                generator = og.Generator(self.model, params)
                generator.append_tokens(input_tokens)

                output_tokens = []
                while not generator.is_done():
                    generator.generate_next_token()
                    new_token = generator.get_next_tokens()[0]
                    output_tokens.append(new_token)

                return self.tokenizer.decode(output_tokens).strip()
            except Exception as e:
                logger.error("Ошибка генерации ONNX: %s", e)
                return None


def _wipe_path(path: str):
    """Полностью удаляет файл или папку."""
    try:
        if os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
        elif os.path.exists(path):
            os.remove(path)
    except Exception as e:
        logger.warning("Не удалось удалить %s: %s", path, e)


def _wipe_models_root():
    """Удаляет всю папку с моделями."""
    _wipe_path(MODELS_ROOT)
    logger.info("AIChat: очищена папка %s", MODELS_ROOT)


def _wipe_partial_files(root: str):
    """Удаляет все .part файлы и временные артефакты HF."""
    try:
        for dirpath, _dirs, files in os.walk(root):
            for f in files:
                if f.endswith(".part") or f.endswith(".incomplete"):
                    _wipe_path(os.path.join(dirpath, f))
    except Exception as e:
        logger.warning("Ошибка очистки .part в %s: %s", root, e)


async def _download_onnx_model(repo_id: str, dest: str, subfolder: str = ""):
    """Скачивает все файлы модели через huggingface_hub."""
    os.makedirs(dest, exist_ok=True)

    if subfolder:
        allow_patterns = [f"{subfolder.rstrip('/')}/*"]
    else:
        allow_patterns = ["*"]

    ignore_patterns = [
        "*.bin", "*.safetensors", "*.pt", "*.pth",
        "pytorch_model*", "*.h5", "*.msgpack",
    ]

    logger.info("Скачиваю модель %s (подпапка: %s)", repo_id, subfolder or "корень")
    await asyncio.to_thread(
        snapshot_download,
        repo_id=repo_id,
        local_dir=dest,
        allow_patterns=allow_patterns,
        ignore_patterns=ignore_patterns,
        local_dir_use_symlinks=False,
    )
    logger.info("Модель сохранена: %s", dest)
    return dest


