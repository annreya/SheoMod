        if not self.session:
            return

        text = message.raw_text
        if not text:
            return

        chats = self._get_active_chats()
        chat_msgs = self.bot_message_ids.get(message.chat_id, set())

        if message.out:
            if not self.config["REPLY_TO_SELF"]:
                return
            if message.id in chat_msgs:
                return
            trigger = self.config["TRIGGER_WORD"].lower()
            if not trigger or trigger not in text.lower():
                return
            if not self.config["OWNER_BYPASS"]:
                if message.chat_id not in chats:
                    return
        else:
            if message.chat_id not in chats:
                return
            reply_msg = (
                await message.get_reply_message() if message.is_reply else None
            )
            if not self._is_triggered(text, message.chat_id, reply_msg):
                return

        now = message.date.timestamp()
        if now - self.last_reply.get(message.chat_id, 0) < self.config["COOLDOWN"]:
            return
        self.last_reply[message.chat_id] = now

        clean = self._clean_text(text)
        if not clean:
            return

        try:
            reply_text = await self._ask_ai(clean)
            if reply_text:
                sent = await message.reply(reply_text)
                chat_msgs.add(sent.id)
                self.bot_message_ids[message.chat_id] = chat_msgs
        except Exception as e:
            logger.error("AIChat: ошибка генерации ответа: %s", e)
