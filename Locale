    @loader.command(
        ru_doc="[on/off/list] - Управление ИИ в этом чате",
        en_doc="[on/off/list] - Manage AI in this chat",
    )
    async def aichat(self, message):
        """Включить/выключить ИИ в этом чате"""
        raw = utils.get_args_raw(message).strip().lower()
        chat_id = message.chat_id

        if raw == "on":
            self._add_active_chat(chat_id)
            await utils.answer(message, "ИИ-ответы включены в этом чате.")
        elif raw == "off":
            self._remove_active_chat(chat_id)
            await utils.answer(message, "ИИ-ответы выключены в этом чате.")
        elif raw == "list":
            chats = self._get_active_chats()
            if not chats:
                await utils.answer(message, "Нет активных чатов.")
                return
            lines = [f"Активных чатов: {len(chats)}"]
            for cid in sorted(chats):
                lines.append(f"• <code>{cid}</code>")
            await utils.answer(message, "\n".join(lines))
        else:
            await utils.answer(
                message,
                "Использование: .aichat on | off | list",
            )

