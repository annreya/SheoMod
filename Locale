    def _models_size_mb(self):
        total = 0
        try:
            for dirpath, _dirs, files in os.walk(MODELS_ROOT):
                for f in files:
                    fp = os.path.join(dirpath, f)
                    if os.path.exists(fp):
                        total += os.path.getsize(fp)
        except Exception:
            pass
        return total / (1024 * 1024)

