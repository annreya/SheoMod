    # ==================== Active chats (из config) ====================

    def _get_active_chats(self):
        raw = self.config["ACTIVE_CHATS"] or ""
        result = set()
        for chunk in raw.split(","):
            chunk = chunk.strip()
            if not chunk:
                continue
            try:
                result.add(int(chunk))
            except ValueError:
                continue
        return result

    def _set_active_chats(self, chats):
        self.config["ACTIVE_CHATS"] = ",".join(str(c) for c in sorted(chats))

    def _add_active_chat(self, chat_id):
        chats = self._get_active_chats()
        chats.add(int(chat_id))
        self._set_active_chats(chats)

    def _remove_active_chat(self, chat_id):
        chats = self._get_active_chats()
        chats.discard(int(chat_id))
        self._set_active_chats(chats)

    # ==================== Engine ====================

    async def _init_local_engine(self):
        async with self._download_lock:
            model_key = self.config["LOCAL_MODEL"]
            custom_path = self.config["LOCAL_MODEL_PATH"].strip()

            if custom_path:
                path = custom_path
                template = self._QWEN_TEMPLATE
            else:
                entry = self._MODELS.get(model_key)
                if not entry:
                    logger.error(
                        "Неизвестный ключ модели: %s. Доступные: %s",
                        model_key, ", ".join(self._MODELS.keys()),
                    )
                    return
                repo_id, subfolder, template, _desc = entry
                base = os.path.join(MODELS_ROOT, model_key)
                path = os.path.join(base, subfolder) if subfolder else base
                cfg_path = os.path.join(path, "genai_config.json")

                if not os.path.exists(cfg_path):
                    # Если папка есть, но конфига нет — значит, скачивание
                    # было прервано или неполное. Сносим и качаем заново.
                    if os.path.exists(base):
                        logger.warning(
                            "Обнаружены неполные данные модели, "
                            "удаляю %s и скачиваю заново", base,
                        )
                        await asyncio.to_thread(_wipe_path, base)

                    logger.info(
                        "Скачиваю ONNX-модель: %s (подпапка: %s)",
                        repo_id, subfolder or "корень",
                    )
                    try:
                        await _download_onnx_model(repo_id, base, subfolder)
                        logger.info("ONNX-модель сохранена: %s", base)
                    except Exception as e:
                        logger.error("Не удалось скачать ONNX-модель: %s", e)
                        return

                if not os.path.exists(cfg_path):
                    logger.error(
                        "После скачивания genai_config.json всё ещё отсутствует: %s. "
                        "Проверь правильность ключа модели или LOCAL_MODEL_PATH.",
                        cfg_path,
                    )
                    return

            self.engine = _ONNXEngine(path, template, max_length=4096)
            ok = await asyncio.to_thread(self.engine.load)
            self._engine_ready = ok

    # ==================== Helpers ====================

    def _is_triggered(self, text, chat_id, reply_msg):
        trigger = self.config["TRIGGER_WORD"].lower()
        if trigger and trigger in text.lower():
            return True
        if reply_msg and reply_msg.id in self.bot_message_ids.get(chat_id, set()):
            return True
        return False

    def _clean_text(self, text):
        trigger = self.config["TRIGGER_WORD"]
        if not trigger:
            return text.strip()
        return re.sub(
            re.escape(trigger), "", text, flags=re.IGNORECASE
        ).strip(" ,.!?-—")

    async def _ask_ai(self, text):
        if not self.engine or not self._engine_ready:
            logger.warning("AIChat: локальная модель не загружена, ответ невозможен")
            return None
        return await asyncio.to_thread(
            self.engine.generate,
            self.config["SYSTEM_PROMPT"],
            text,
            self.config["MAX_TOKENS"],
        )

    def _build_model_markup(self):
        rows = []
        current = self.config["LOCAL_MODEL"]
        for key, entry in self._MODELS.items():
            desc = entry[3] if len(entry) > 3 else key
            mark = "✅ " if key == current else ""
            rows.append(
                [
                    {
                        "text": f"{mark}{desc}",
                        "callback": self._on_model_pick,
                        "args": (key,),
                    }
                ]
            )
        rows.append(
            [
                {
                    "text": "🗑 Очистить временные файлы",
                    "callback": self._on_wipe_cache,
                    "args": (),
                }
            ]
        )
        rows.append(
            [
                {
                    "text": "Закрыть",
                    "action": "close",
                }
            ]
        )
        return rows

    def _model_text(self):
        current = self.config["LOCAL_MODEL"]
        if self._engine_ready:
            state = "загружена"
        else:
            state = "не загружена"
        desc = self._MODELS.get(current, ("", "", "", current))[3] \
            if current in self._MODELS else current
        return (
            "Выбор локальной модели\n\n"
            f"Текущая: <b>{current}</b>\n"
            f"Описание: {desc}\n"
            f"Состояние: {state}\n\n"
            "После выбора модель начнёт скачиваться и загружаться. "
            "Это может занять несколько минут."
        )

    async def _on_model_pick(self, call: InlineCall, key: str):
        if key not in self._MODELS:
            await call.answer("Неизвестная модель", show_alert=True)
            return
        self.config["LOCAL_MODEL"] = key
        await call.answer(f"Выбрана модель: {key}", show_alert=False)
        try:
            await call.edit(self._model_text(), reply_markup=self._build_model_markup())
        except Exception:
            pass
        self._engine_ready = False
        self.engine = None
        asyncio.create_task(self._init_local_engine())

    async def _on_wipe_cache(self, call: InlineCall):
        await call.answer("Удаляю временные файлы...", show_alert=False)
        self._engine_ready = False
        self.engine = None
        await asyncio.to_thread(_wipe_models_root)
        try:
            await call.edit(
                "Временные файлы моделей удалены.\n"
                "Используй .aireload для повторного скачивания.",
                reply_markup=[[{"text": "Закрыть", "action": "close"}]],
            )
        except Exception:
            pass

